{
  "name": "fluxor",
  "private": true,
  "homepage": "https://github.com/IgorKaliel/quote-services-backend#readme",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IgorKaliel/quote-services-backend/issues",
    "email": "igorkaliel@gmail.com"
  },
  "scripts": {
    "build": "pnpm --filter @fluxor/zod run build && pnpm --filter @fluxor/drizzle run build && pnpm --filter @fluxor/backend run build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fluxor/drizzle run db:generate",
    "db:migrate": "pnpm --filter @fluxor/drizzle run db:migrate",
    "db:up": "docker compose up -d",
    "dev": "run-p dev:*",
    "dev:backend": "pnpm --filter @fluxor/zod run build && pnpm --filter @fluxor/drizzle run build && pnpm --filter @fluxor/backend run dev",
    "test": "pnpm --filter @fluxor/tests run test",
    "clean": "rimraf node_modules pnpm-lock.yaml && rimraf \"**/node_modules\" \"**/dist\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "wait-port": "^1.1.0"
  }
}
